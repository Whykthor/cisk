rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção pública: livros (leitura livre)
    match /livros/{livroId} {
      allow read: if true;
      allow write: if false;
    }

    // Configuração global (encontros): leitura livre, escrita só de admin
    match /configuracao/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Documentos de usuário: somente o próprio usuário lê/escreve
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Estante pessoal do usuário: somente o próprio usuário lê/escreve seus livros
    match /usuarios/{uid}/estante/{livroId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Clubes do usuário: somente o próprio usuário lê/escreve seus clubes
    match /usuarios/{uid}/clubes/{clubeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Encontros de um clube: somente o próprio usuário lê/escreve os encontros dos seus clubes
    match /usuarios/{uid}/clubes/{clubeId}/encontros/{encontroId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Demais coleções/documentos: negado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
